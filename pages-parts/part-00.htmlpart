:where(#gp-lang-sheet) { --gp-lang-bg: var(--gp-theme-backdrop, #14202bf2); --gp-lang-panel: var(--gp-theme-bg, #1d2c3a);
  --gp-lang-ink: var(--gp-theme-ink, #eef6ff); --gp-lang-btn: var(--gp-theme-panel, #2a3d4f); --gp-lang-on: var(--gp-theme-accent, #ffd166);
  --gp-lang-on-ink: var(--gp-theme-accent-ink, #14202b); --gp-lang-radius: var(--gp-theme-radius, 16px); --gp-lang-font: var(--gp-theme-font, ${et}); }
#gp-lang-sheet { position: fixed; inset: 0; z-index: 2147483000; display: flex; align-items: center; justify-content: center;
  background: var(--gp-lang-bg); padding: max(10px, env(safe-area-inset-top)) max(10px, env(safe-area-inset-right))
  max(10px, env(safe-area-inset-bottom)) max(10px, env(safe-area-inset-left)); box-sizing: border-box; pointer-events: auto; }
#gp-lang-sheet .gp-lang-panel { background: var(--gp-lang-panel); color: var(--gp-lang-ink); border-radius: var(--gp-lang-radius); padding: 12px;
  box-sizing: border-box; width: min(100%, 620px); max-height: 100%; overflow: auto; display: grid; gap: 8px;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); font: 600 15px/1.2 var(--gp-lang-font); }
#gp-lang-sheet .gp-lang-title { grid-column: 1 / -1; margin: 0 0 2px; font-size: 18px; text-align: center; font-family: var(--gp-theme-display, inherit); }
#gp-lang-sheet button { display: flex; align-items: center; gap: 8px; min-width: 0; margin: 0; padding: 6px 10px; border: 0;
  border-radius: 12px; background: var(--gp-lang-btn); color: inherit; font: inherit; text-align: left; cursor: pointer; }
#gp-lang-sheet button[aria-pressed=true] { background: var(--gp-lang-on); color: var(--gp-lang-on-ink); }
#gp-lang-sheet button:focus-visible { outline: 3px solid var(--gp-lang-on); outline-offset: 2px; }
#gp-lang-sheet .gp-flag, .gp-lang .gp-flag { flex: none; border-radius: 3px; box-shadow: 0 0 0 1px #0004; }
/* Words never break inside: "Português (Brasil)" wraps between its words */
#gp-lang-sheet .gp-lang-name { overflow-wrap: normal; word-break: normal; hyphens: manual; }
.gp-lang { display: inline-flex; align-items: center; justify-content: center; gap: 8px; }
