од`,"garage.plant.desc":`Гиперкары и тяжёлая техника`,"garage.hangar.name":`Космический ангар`,"garage.hangar.desc":`Роверы, шаттлы и ракеты`,"level.title":`Новый гараж!`,"level.surprise":`Новых машин здесь: {n}`,"work.mud":`Грязь`,"work.rust":`Ржавчина`,"work.polish":`Царапины`,"work.parts":`Детали`,"work.dust":`Пыль`,"work.engine":`Мотор`,"work.paint":`Покраска`,"work.soot":`Копоть`,"rarity.common":`Обычная`,"rarity.uncommon":`Необычная`,"rarity.rare":`Редкая`,"rarity.epic":`Эпическая`,"rarity.legendary":`Легендарная`,"rarity.mythic":`Мифическая`,"rarity.unknown":`Неизвестная`,"variant.standard":`Стандарт`,"variant.racing":`Гоночная`,"variant.police":`Патрульная`,"variant.luxury":`Люкс`,"variant.offroad":`Внедорожная`,"variant.prototype":`Прототип`,"variant.limited":`Лимитированная`,"cls.car":`Легковые`,"cls.sport":`Спорткары`,"cls.truck":`Грузовики и автобусы`,"cls.special":`Спецтехника`,"cls.moto":`Мотоциклы`,"cls.heavy":`Тяжёлая техника`,"cls.space":`Космос`,"story.barn":`Найдена в амбаре спустя 30 лет`,"story.orbit":`Снят с падающей орбиты`,"story.splash":`Выловлен из океана после приводнения`,"story.reentry":`Обгорел при входе в атмосферу`,"story.pad":`Десятилетия простоял на стартовом столе`,"story.derelict":`Отбуксирован с заброшенной станции`,"story.probe":`Возвращён из потерянной миссии`,"story.lake":`Вытащена из озера`,"story.crash":`Спасена после аварии на трассе`,"story.fire":`Пережила пожар в гараже`,"story.desert":`Откопана после песчаной бури`,"story.snow":`Провела зиму под снегом`,"story.museum":`Прислана музеем`,"story.gate":`Оставлена у ворот ночью неизвестным`,"story.storage":`Десятилетиями пылилась на складе`,"story.auction":`Куплена на аукционе вслепую`,"story.field":`Найдена в поле, наполовину заросшей`,"story.collector":`Потерянное сокровище коллекционера`,"album.title":`Альбом`,"album.models":`Модели {a}/{b}`,"album.variants":`Версии {a}/{b}`,"album.rare":`Редкие {a}/{b}`,"album.done":{one:`Восстановлено: {n}`,few:`Восстановлено: {n}`,many: