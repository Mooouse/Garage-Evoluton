        --glass: rgba(16,20,32,0.84); --edge: rgba(255,255,255,0.14); --amber: #ffb02e; --cyan: #5ff6ff; --ok: #5fd06a; }
  #ui * { box-sizing: border-box; }
  #ui button { pointer-events: auto; font: 800 16px ${et}, ${de}; min-height: ${e}px; min-width: ${e}px;
